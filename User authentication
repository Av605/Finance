<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Firebase Login</title>
  <style>
    button:disabled { opacity: 0.5; cursor: not-allowed; }
  </style>
</head>

<body style="font-family: Arial; text-align:center; margin-top:100px;">
  <h2>Sign Up / Login</h2>

  <form id="authForm">
    <input type="email" id="email" placeholder="Email" required autocomplete="email"><br><br>
    <input type="password" id="password" placeholder="Password" required autocomplete="current-password"><br><br>
    <button type="button" id="signUpBtn" onclick="signUp()">Sign Up</button>
    <button type="button" id="loginBtn" onclick="login()">Login</button>
  </form>

  <p id="msg"></p>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
    import { getFirestore, setDoc, doc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "YOUR_API_KEY",
      authDomain: "FINANCE_PROJECT.firebaseapp.com",
      projectId: "SAVE"EM_PROJECT_ID",
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    function setLoading(isLoading) {
      document.getElementById("signUpBtn").disabled = isLoading;
      document.getElementById("loginBtn").disabled = isLoading;
    }

    window.signUp = async function () {
      const email = document.getElementById("email").value;
      const password = document.getElementById("password").value;

      if (!email || !password) {
        document.getElementById("msg").innerText = "Please fill in all fields";
        return;
      }

      setLoading(true);
      try {
        const userCredential = await createUserWithEmailAndPassword(auth, email, password);
        const user = userCredential.user;

        await setDoc(doc(db, "users", user.uid), {
          email: user.email,
          createdAt: new Date()
        });

        document.getElementById("msg").innerText = "User Created & Saved!";
      } catch (err) {
        document.getElementById("msg").innerText = err.message;
      } finally {
        setLoading(false);
      }
    };

    window.login = async function () {
      const email = document.getElementById("email").value;
      const password = document.getElementById("password").value;

      if (!email || !password) {
        document.getElementById("msg").innerText = "Please fill in all fields";
        return;
      }

      setLoading(true);
      try {
        signInWithEmailAndPassword(auth, email, password)
  .then(() => {
    window.location.href = "dashboard.html";
  })
        document.getElementById("msg").innerText = err.message;
      } finally {
        setLoading(false);
      }
    };
  </script>
</body>
</html>
